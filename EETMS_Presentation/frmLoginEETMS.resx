  <data name="label3.Text" xml:space="preserve">
    <value>An event and ticketing management system that provides an easy way
 to manage events and categories, sell different ticket types, handle 
customer data, track payments and refunds, and generate reports 
and statistics for better decision-making.</value>
  </data>
